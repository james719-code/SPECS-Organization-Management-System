rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function account() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return accountExists() && account().deactivated != true && account().type == 'admin';
    }

    function isVerifiedMember() {
      return accountExists() && account().deactivated != true
        && (account().type == 'admin'
          || (account().verified == true && request.auth.token.email_verified == true));
    }

    function isOfficerOrAdmin() {
      return isVerifiedMember() && (account().type == 'officer' || account().type == 'admin');
    }

    function isStudentOwner(studentId) {
      return signedIn() && studentId is string && studentId != '' && (
        request.auth.uid == studentId
        || (accountExists() && (account().get('studentId', '') == studentId || account().get('students', '') == studentId))
      );
    }


    match /accounts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOfficerOrAdmin());
      // The registration backend binds ownership to the verified token's UID
      // and commits the profile/account/student-number reservation together.
      allow create: if false;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'updatedAt']));
      // Account/Auth deletion is coordinated by the backend action so a
      // client cannot leave an orphaned Firebase Auth user behind.
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isVerifiedMember();
      allow create: if false;
      // Student numbers are changed only by the transactional backend, even
      // for officers, so a direct write cannot bypass uniqueness checks.
      allow update: if (isOfficerOrAdmin() || (isVerifiedMember() && isStudentOwner(studentId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'yearLevel', 'section', 'address', 'volunteer_request_status', 'updatedAt'
          ]);
      allow delete: if false;
    }

    match /student_numbers/{number} {
      allow read, write: if false;
    }

    match /officers/{officerId} {
      allow read: if isVerifiedMember();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /team_memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if isVerifiedMember();
      allow write: if isAdmin();
    }

    // Keep collection permissions explicit. A broad wildcard match would be
    // OR-ed with the rules above and could accidentally let an officer write
    // accounts, settings, or team memberships.
    match /events/{documentId} {
      // The public landing page contains the organization's event calendar.
      // Only non-archived event documents are public; signed-in users may
      // still read archived events for dashboard/history views. `null` is
      // treated as not archived for legacy Appwrite rows.
      allow read: if isVerifiedMember()
        || resource.data.archived == false
        || resource.data.archived == null;
      allow write: if isOfficerOrAdmin();
    }

    match /attendance/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /payments/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /revenue/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /expenses/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /stories/{documentId} {
      // Published stories are shown on the public landing page. Pending
      // stories remain visible only to signed-in dashboard users.
      allow read: if isVerifiedMember() || resource.data.isAccepted == true;
      allow write: if isOfficerOrAdmin();
    }

    match /files/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /tasks/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /starting_balances/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /signatories/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /event_non_org/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isOfficerOrAdmin();
    }

    match /metadata/{documentId} {
      allow read: if isVerifiedMember();
      allow write: if isAdmin();
    }

    match /notifications_all/{notificationId} {
      allow read: if isVerifiedMember() && accountExists() && account().deactivated != true;
      allow write: if isAdmin();
    }

    match /notifications_students/{notificationId} {
      allow read: if isVerifiedMember() && accountExists() && account().type == 'student' && account().deactivated != true;
      allow write: if isAdmin();
    }

    match /notifications_officers/{notificationId} {
      allow read: if isVerifiedMember() && accountExists()
        && (account().type == 'officer' || account().type == 'admin')
        && account().deactivated != true;
      allow write: if isAdmin();
    }

    match /notifications_direct/{notificationId} {
      allow read: if isVerifiedMember() && resource.data.recipientUid == request.auth.uid;
      allow write: if isAdmin();
    }

    match /notification_reads/{readId} {
      allow read: if isVerifiedMember() && resource.data.userUid == request.auth.uid;
      allow create: if isVerifiedMember() && request.resource.data.userUid == request.auth.uid;
      allow update: if isVerifiedMember()
        && resource.data.userUid == request.auth.uid
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
    }
  }
}
