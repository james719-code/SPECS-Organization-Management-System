# App Configuration
VITE_APP_TITLE=SPECS Organization Management System

# Development Mode
VITE_USE_MOCK_DATA=false

# Provider Selection (appwrite, firebase, supabase-edge)
VITE_AUTH_PROVIDER=firebase
VITE_DB_PROVIDER=firebase
VITE_STORAGE_PROVIDER=supabase-edge

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# Firestore uses the default database; this value is retained for compatibility.
VITE_DATABASE_ID=(default)

# Core Collections
VITE_COLLECTION_ID_ACCOUNTS=accounts
VITE_COLLECTION_ID_STUDENTS=students
VITE_COLLECTION_ID_OFFICERS=officers
VITE_COLLECTION_ID_ADMINS=admins

# Events & Attendance
VITE_COLLECTION_ID_EVENTS=events
VITE_COLLECTION_ID_ATTENDANCE=attendance

# Finance
VITE_COLLECTION_ID_PAYMENTS=payments
VITE_COLLECTION_ID_EXPENSES=expenses
VITE_COLLECTION_ID_REVENUE=revenue
VITE_COLLECTION_ID_STARTING_BALANCES=starting_balances

# Content & Files
VITE_COLLECTION_ID_STORIES=stories
VITE_COLLECTION_ID_FILES=files
VITE_COLLECTION_ID_TASKS=tasks

# Buckets
VITE_BUCKET_ID_RESUMES=resumes
VITE_BUCKET_ID_SCHEDULES=specs-schedule
VITE_BUCKET_ID_EVENT_IMAGES=specs-events
VITE_BUCKET_ID_HIGHLIGHT_IMAGES=specs-highlights
VITE_BUCKET_PUBLIC_FILES=specs-public-files
VITE_BUCKET_ID_UPLOADS=specs-files

# Functions
VITE_FUNCTION_ID=specs-api

# Teams
VITE_TEAM_ID_STUDENTS=
VITE_TEAM_ID_OFFICERS=
VITE_TEAM_ID_ADMINS=
VITE_TEAM_ID_VOLUNTEERS=

# Firebase Configuration (optional - for firebase provider)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_WEB_API_KEY=
# Web Push certificate key pair (Firebase Console > Project settings > Cloud Messaging > Web configuration).
# Public value; without it the push-permission prompt is hidden and notifications stay in-app only.
VITE_FIREBASE_VAPID_KEY=

# Supabase Edge Function / Storage client configuration
# Only public client configuration belongs in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_FUNCTION_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET_EVENT_IMAGES=specs-events
VITE_SUPABASE_BUCKET_UPLOADS=specs-files
VITE_SUPABASE_BUCKET_RESUMES=resumes
VITE_SUPABASE_BUCKET_SCHEDULES=specs-schedule
VITE_SUPABASE_BUCKET_PUBLIC_FILES=specs-public-files
VITE_SUPABASE_BUCKET_HIGHLIGHT_IMAGES=specs-highlights
VITE_SUPABASE_BUCKET_PICTURES=specs-picture

# Cloudflare R2 Configuration (optional - for cloudflare-r2 storage provider)
# Browser builds must use a backend proxy or pre-signed URLs. Do not expose R2
# access keys with VITE_ variables.
VITE_R2_ENDPOINT=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_URL=
